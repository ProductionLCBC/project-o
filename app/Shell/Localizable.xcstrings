    "engine.anotherBuild" : {
      "comment" : "Offered when the app finds an engine of another build running and nothing is on screen. %1$@ is the engine's version, %2$@ the app's.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The engine running is version %1$@ and this is Project O %2$@. Restart it while nothing is live?"
          }
        }
      }
    },
    "engine.behindOutput" : {
      "comment" : "A note shown above an output for ten seconds when it covers the app's window. %lld is the output's number; ⌃⌥⌘⎋ is Control-Option-Command-Escape.",
