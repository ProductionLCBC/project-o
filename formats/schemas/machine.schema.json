{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-o.lcbcchurch.com/schemas/machine.schema.json",
  "title": "machine.json",
  "description": "Spec 1 §3 — machine settings: uuid, campusName, defaultRole, operatorLock, libraryMode, mediaRoot, defaultImportFolder, fallbackFont, thumbnailStack, decoderCapDefault, tracking, timers, popups, timeFormat, timeZone, startupMacro, shutdownMacro, restoreLastState, snapshots, commandBar, network.",
  "type": "object",
  "required": ["schema", "app", "kind", "uuid", "campusName", "defaultRole", "operatorLock", "libraryMode", "mediaRoot", "defaultImportFolder", "fallbackFont", "thumbnailStack", "decoderCapDefault", "tracking", "timers", "popups", "timeFormat", "timeZone", "startupMacro", "shutdownMacro", "restoreLastState", "snapshots", "commandBar", "network"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "app": { "type": "string" },
    "kind": { "const": "machine" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "campusName": { "type": "string" },
    "defaultRole": { "enum": ["editor", "operator", "librarian"] },
    "operatorLock": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
    "libraryMode": { "enum": ["readOnlyMasters", "writable"] },
    "mediaRoot": { "type": "string" },
    "defaultImportFolder": { "type": "string" },
    "fallbackFont": { "type": "string" },
    "thumbnailStack": { "type": "integer", "minimum": 1 },
    "decoderCapDefault": { "enum": [2, 3] },
    "tracking": {
      "type": "object",
      "required": ["grade", "transition", "audioTransition", "gain", "chase"],
      "properties": {
        "grade": { "type": "boolean" },
        "transition": { "type": "boolean" },
        "audioTransition": { "type": "boolean" },
        "gain": { "type": "boolean" },
        "chase": { "type": "boolean" }
      }
    },
    "timers": { "type": "integer", "minimum": 0 },
    "popups": { "type": "integer", "minimum": 0 },
    "timeFormat": { "type": "string" },
    "timeZone": { "type": "string" },
    "startupMacro": { "type": ["integer", "null"] },
    "shutdownMacro": { "type": ["integer", "null"] },
    "restoreLastState": { "type": "boolean" },
    "snapshots": {
      "type": "object",
      "required": ["cadence", "retention"],
      "properties": { "cadence": { "type": "string" }, "retention": { "type": "string" } }
    },
    "commandBar": { "type": "boolean" },
    "network": {
      "type": "object",
      "required": ["oscInPort", "oscOutTargets", "apiPort", "apiToken"],
      "properties": {
        "oscInPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "oscOutTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "port"],
            "properties": { "host": { "type": "string" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
          }
        },
        "apiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "apiToken": { "type": "string" }
      }
    }
  }
}
