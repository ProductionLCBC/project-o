{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-o.lcbcchurch.com/schemas/audio-outputs.schema.json",
  "title": "audio-outputs.json",
  "description": "Spec 1 §3 — Audio Output: kind (device or sdiEmbedded), device (Core Audio device UID, or the SDI output number), channels, delayMs (0–1000), fallbackDevice.",
  "type": "object",
  "required": ["schema", "app", "kind", "audioOutputs"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "app": { "type": "string" },
    "kind": { "const": "audioOutputs" },
    "audioOutputs": { "type": "array", "items": { "$ref": "#/$defs/audioOutput" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "audioOutput": {
      "type": "object",
      "required": ["number", "label", "uuid", "kind", "device", "channels", "delayMs", "fallbackDevice"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "uuid": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["device", "sdiEmbedded"] },
        "device": { "type": ["string", "integer"] },
        "channels": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "delayMs": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "fallbackDevice": { "type": ["string", "null"] }
      }
    }
  }
}
