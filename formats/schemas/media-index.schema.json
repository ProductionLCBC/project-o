{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-o.lcbcchurch.com/schemas/media-index.schema.json",
  "title": "media-index.json",
  "description": "Spec 1 §7 — the library index: entries (id, path, kind, size, modified, durationMs, fps, width, height, hasAudio, hasAlpha, codec, poster, defaults, addedAt, folder; tracks and crossfadeMs for audio sets) and the replaced map that replace media records.",
  "type": "object",
  "required": ["schema", "app", "kind", "entries", "replaced"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "app": { "type": "string" },
    "kind": { "const": "mediaIndex" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "replaced": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mediaId" } }
  },
  "$defs": {
    "mediaId": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64}|slide:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$" },
    "rate": {
      "type": "object",
      "required": ["num", "den"],
      "properties": { "num": { "type": "integer", "minimum": 1 }, "den": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "path", "kind", "size", "modified", "durationMs", "fps", "width", "height", "hasAudio", "hasAlpha", "codec", "poster", "defaults", "addedAt", "folder"],
      "properties": {
        "id": { "$ref": "#/$defs/mediaId" },
        "path": { "type": "string" },
        "kind": { "enum": ["video", "image", "audio", "audioSet", "slide", "template"] },
        "size": { "type": "integer", "minimum": 0 },
        "modified": { "type": ["string", "null"] },
        "durationMs": { "type": ["integer", "null"] },
        "fps": { "oneOf": [{ "$ref": "#/$defs/rate" }, { "type": "null" }] },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] },
        "hasAudio": { "type": "boolean" },
        "hasAlpha": { "type": "boolean" },
        "codec": { "type": ["string", "null"] },
        "poster": { "type": ["string", "null"] },
        "defaults": {
          "type": "object",
          "required": ["trimInMs", "trimOutMs", "loop", "gain", "grade", "syncOffsetMs", "defaultChannel"],
          "properties": {
            "trimInMs": { "type": ["integer", "null"] },
            "trimOutMs": { "type": ["integer", "null"] },
            "loop": { "type": "boolean" },
            "gain": { "type": ["number", "null"] },
            "grade": { "type": ["integer", "null"] },
            "syncOffsetMs": { "type": ["integer", "null"], "minimum": -1000, "maximum": 1000 },
            "defaultChannel": { "type": ["integer", "null"] }
          }
        },
        "addedAt": { "type": ["string", "null"] },
        "folder": { "type": ["string", "null"] },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/mediaId" } },
        "crossfadeMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
