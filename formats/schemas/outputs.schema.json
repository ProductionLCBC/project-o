{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-o.lcbcchurch.com/schemas/outputs.schema.json",
  "title": "outputs.json",
  "description": "Spec 1 §3 — Output: kind, device, format {width, height, rate {num, den}, interlaced}, colorRange, genlock (SDI only), defaultStack, keyFillPartner, keyMode, transitions {switch, blackout}.",
  "type": "object",
  "required": ["schema", "app", "kind", "outputs"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "app": { "type": "string" },
    "kind": { "const": "outputs" },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "format": {
      "type": "object",
      "required": ["width", "height", "rate", "interlaced"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "rate": {
          "type": "object",
          "required": ["num", "den"],
          "properties": { "num": { "type": "integer", "minimum": 1 }, "den": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        },
        "interlaced": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "required": ["number", "label", "uuid", "kind", "device", "format", "colorRange", "genlock", "defaultStack", "keyFillPartner", "keyMode", "transitions"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "uuid": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["sdi", "display", "ndi", "multiviewer"] },
        "device": { "type": "string" },
        "format": { "$ref": "#/$defs/format" },
        "colorRange": { "enum": ["full", "limited"] },
        "genlock": { "enum": ["reference", "freeRun", null] },
        "defaultStack": { "type": "integer", "minimum": 1 },
        "keyFillPartner": { "type": ["integer", "null"] },
        "keyMode": { "enum": ["shaped", "unshaped"] },
        "transitions": {
          "type": "object",
          "required": ["switch", "blackout"],
          "properties": { "switch": { "type": "integer", "minimum": 1 }, "blackout": { "type": "integer", "minimum": 1 } }
        }
      }
    }
  }
}
