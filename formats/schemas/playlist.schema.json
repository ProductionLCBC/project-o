{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-o.lcbcchurch.com/schemas/playlist.schema.json",
  "title": "playlists/YYYY-MM-DD-slug.json",
  "description": "Spec 1 §3 — Playlist: uuid, title, serviceDate (ISO date or null), archived, items (header, linked list by number, or local copy by uuid). Playlists carry no cues of their own.",
  "type": "object",
  "required": ["schema", "app", "kind", "uuid", "title", "serviceDate", "archived", "items"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "app": { "type": "string" },
    "kind": { "const": "playlist" },
    "uuid": { "$ref": "#/$defs/uuid" },
    "title": { "type": "string" },
    "serviceDate": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "archived": { "type": "boolean" },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "object", "required": ["kind", "label"], "properties": { "kind": { "const": "header" }, "label": { "type": "string" } } },
          { "type": "object", "required": ["kind", "list"], "properties": { "kind": { "const": "linked" }, "list": { "type": "integer", "minimum": 1 } } },
          { "type": "object", "required": ["kind", "localUuid"], "properties": { "kind": { "const": "local" }, "localUuid": { "$ref": "#/$defs/uuid" } } }
        ]
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
