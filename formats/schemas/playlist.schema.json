{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-o.lcbcchurch.com/schemas/playlist.schema.json",
  "title": "playlists/slug.json",
  "description": "Spec 1 §3, Spec 7 §3 — Playlist: uuid, title (its name on the machine), serviceDate (ISO date or null), serviceTime (HH:MM or null), archived, items. Every item has a uuid, unique within the playlist; a header has a label, a linked item names its list by number and by listUuid, a local item its local copy by uuid. Playlists carry no cues of their own.",
  "type": "object",
  "required": ["schema", "app", "kind", "uuid", "title", "serviceDate", "serviceTime", "archived", "items"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "app": { "type": "string" },
    "kind": { "const": "playlist" },
    "uuid": { "$ref": "#/$defs/uuid" },
    "title": { "type": "string", "minLength": 1 },
    "serviceDate": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "serviceTime": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "archived": { "type": "boolean" },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "object", "required": ["kind", "label", "uuid"],
            "properties": { "kind": { "const": "header" }, "label": { "type": "string" }, "uuid": { "$ref": "#/$defs/uuid" } } },
          { "type": "object", "required": ["kind", "list", "uuid"],
            "properties": { "kind": { "const": "linked" }, "list": { "type": "integer", "minimum": 1 }, "listUuid": { "$ref": "#/$defs/uuid" }, "uuid": { "$ref": "#/$defs/uuid" } } },
          { "type": "object", "required": ["kind", "localUuid", "uuid"],
            "properties": { "kind": { "const": "local" }, "localUuid": { "$ref": "#/$defs/uuid" }, "uuid": { "$ref": "#/$defs/uuid" } } }
        ]
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
